# ── Instance / tenant name ───────────────────────────────
# A short name for THIS deployment. Added as a `tenant` label on every metric —
# handy for telling deployments apart, and the upgrade path if you ever run one
# central platform for many clients. Fine to leave as-is for a single install.
TENANT=default

# ── Image versions (pin these; verify current stable at deploy time) ──
PROMETHEUS_VERSION=v3.1.0
GRAFANA_VERSION=11.4.0
ALERTMANAGER_VERSION=v0.28.0
LOKI_VERSION=3.3.0
MONGODB_EXPORTER_VERSION=0.43.1
MSSQL_EXPORTER_VERSION=0.16.0
SNMP_EXPORTER_VERSION=v0.26.0
BLACKBOX_EXPORTER_VERSION=v0.25.0

# ── Retention ────────────────────────────────────────────
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=50GB

# ── Grafana admin (change per client) ────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# ── SQL Server (sql_exporter DSN; login needs VIEW SERVER STATE) ──
# For a SINGLE SQL Server, set this and you're done.
# For MORE THAN ONE, ignore this and use mssql/servers.conf instead:
#     cp mssql/servers.conf.example mssql/servers.conf     (one "<name> <DSN>" per line)
# If servers.conf exists it wins and this variable is ignored.
#
# encrypt=disable is fine on a trusted LAN; use encrypt=true with a valid cert otherwise.
# MUST be single-quoted — the DSN contains & and ? which break unquoted shell sourcing.
MSSQL_DSN='sqlserver://mon_user:mon_pass@10.0.0.31:1433?database=master&encrypt=disable'

# ── MongoDB (opt-in) ─────────────────────────────────────
# For a SINGLE MongoDB, set this URI. For MORE THAN ONE, ignore it and use
#     cp mongodb/servers.conf.example mongodb/servers.conf
# (one "<name> | <URI> | env=prod" per line). servers.conf wins if it exists.
# Either way you must add "mongodb" to COMPOSE_PROFILES below.
MONGODB_URI=mongodb://mon_user:mon_pass@10.0.0.31:27017

# ── Which database monitors to run ───────────────────────
# Comma-separated. This is the master on/off switch per database type:
#   mssql            SQL Server only  (default)
#   mongodb          MongoDB only
#   mssql,mongodb    both
#   (empty)          neither
# Turning one off stops its exporter AND removes its scrape targets, so you get
# no false "down" alerts. Apply with: bash scripts/deploy.sh
COMPOSE_PROFILES=mssql


# ── Alerting: master on/off switch ───────────────────────
# false = alerts still fire and show in Prometheus/Grafana/Alertmanager, but NO
# email or chat is ever sent. Useful while setting up, or during planned work.
# Apply a change with: bash scripts/deploy.sh
NOTIFICATIONS_ENABLED=true

# ── Alerting: email (SMTP) ───────────────────────────────
SMTP_SMARTHOST=smtp.client.example.com:587
SMTP_FROM=monitoring@client.example.com
SMTP_USER=monitoring@client.example.com
SMTP_PASSWORD=changeme
ALERT_EMAIL_TO=ops@client.example.com

# ── Alerting: chat (Slack incoming webhook) ──────────────
# For Microsoft Teams / Telegram alternatives see RUNBOOK.md
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_CHANNEL=#alerts
