# ── Client / tenant identity ─────────────────────────────
# Becomes the `tenant` label on all exported metrics (multi-tenant-ready).
TENANT=acme

# ── Image versions (pin these; verify current stable at deploy time) ──
PROMETHEUS_VERSION=v3.1.0
GRAFANA_VERSION=11.4.0
ALERTMANAGER_VERSION=v0.28.0
LOKI_VERSION=3.3.0
MONGODB_EXPORTER_VERSION=0.43.1
MSSQL_EXPORTER_VERSION=0.16.0
SNMP_EXPORTER_VERSION=v0.26.0
BLACKBOX_EXPORTER_VERSION=v0.25.0

# ── Retention ────────────────────────────────────────────
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=50GB

# ── Grafana admin (change per client) ────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme

# ── SQL Server (sql_exporter DSN; login needs VIEW SERVER STATE) ──
# encrypt=disable is fine on a trusted LAN; use encrypt=true with a valid cert otherwise.
# MUST be single-quoted — the DSN contains & and ? which break unquoted shell sourcing.
MSSQL_DSN='sqlserver://mon_user:mon_pass@10.0.0.31:1433?database=master&encrypt=disable'

# ── MongoDB (opt-in) ─────────────────────────────────────
# Disabled by default. To enable: set COMPOSE_PROFILES=mongodb below,
# add targets/mongodb.yml back into prometheus.yml, and set this URI.
MONGODB_URI=mongodb://mon_user:mon_pass@10.0.0.31:27017

# Which optional profiles to start. Leave empty for MSSQL-only. Example: mongodb
COMPOSE_PROFILES=

# ── Alerting: email (SMTP) ───────────────────────────────
SMTP_SMARTHOST=smtp.client.example.com:587
SMTP_FROM=monitoring@client.example.com
SMTP_USER=monitoring@client.example.com
SMTP_PASSWORD=changeme
ALERT_EMAIL_TO=ops@client.example.com

# ── Alerting: chat (Slack incoming webhook) ──────────────
# For Microsoft Teams / Telegram alternatives see RUNBOOK.md
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_CHANNEL=#alerts
