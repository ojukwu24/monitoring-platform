        "x": 12,
        "y": 3,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "bargauge",
      "title": "Success rate % by service",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "min": 0,
          "max": 100
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by(service) (increase(txn_transactions_total{result=\"success\", env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\"}[$__range])) / sum by(service) (increase(txn_transactions_total{env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{service}}"
        }
      ],
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "bargauge",
      "title": "Provider p95 by provider",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(provider, le) (increase(txn_provider_response_seconds_bucket{env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{provider}}"
        }
      ],
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "bargauge",
      "title": "Failures by client",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#EAB839",
                "value": null
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by(client) (count_over_time({job=\"transactions\", env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\", result=\"failed\"} | json client=\"clientName\" [$__range])))",
          "legendFormat": "{{client}}",
          "queryType": "instant"
        }
      ],
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "id": 11,
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "logs",
      "title": "Latest failed transactions",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "maxLines": 50,
          "expr": "{job=\"transactions\", env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\", result=\"failed\"} | json | line_format \"{{.service}} \u00b7 {{.channel}} \u00b7 {{.provider}} \u00b7 {{.clientName}} \u00b7 provider {{.contentProviderResponseTime}}ms \u00b7 status {{.status}} \u00b7 ref {{.transactionRef}}\""
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 6
      }
    }
