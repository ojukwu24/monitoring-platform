  "panels": [
    {
      "type": "stat",
      "title": "Transactions",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "\u2014",
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(txn_transactions_total{env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Success rate",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 95
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          },
          "noValue": "\u2014",
          "unit": "percent",
          "decimals": 2
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(increase(txn_transactions_total{result=\"success\", env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\"}[$__range]))) / (sum(increase(txn_transactions_total{env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Failed",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "\u2014",
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(txn_transactions_total{result=\"failed\", env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\"}[$__range])) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Provider p95",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "\u2014",
          "unit": "s",
          "decimals": 2
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (increase(txn_provider_response_seconds_bucket{env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Coure p95",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 3
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "\u2014",
          "unit": "s",
          "decimals": 2
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (increase(txn_coure_response_seconds_bucket{env=~\"$env\", service=~\"$service\", channel=~\"$channel\", provider=~\"$provider\"}[$__range])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
