      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=~\"node|windows\", env=~\"$env\"} == 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "CPU > 90%",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((100 - avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\", env=~\"$env\"}[5m])) * 100 or 100 - avg by(instance) (irate(windows_cpu_time_total{mode=\"idle\", env=~\"$env\"}[5m])) * 100) > 90) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Memory > 90%",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count((100 * (1 - node_memory_MemAvailable_bytes{env=~\"$env\"} / node_memory_MemTotal_bytes{env=~\"$env\"}) or 100 * (1 - windows_os_physical_memory_free_bytes{env=~\"$env\"} / windows_cs_physical_memory_bytes{env=~\"$env\"})) > 90) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
