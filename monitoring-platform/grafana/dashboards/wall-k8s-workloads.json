{
  "uid": "wall-k8s-workloads",
  "title": "\u2638\ufe0f Wall \u2014 Kubernetes Workloads",
  "tags": [
    "wallboard"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up, env)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": [],
        "description": "Switch the wall to one or more environments"
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kube_node_info{env=~\"$env\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": [],
        "description": "kube-state-metrics target (its name: from targets/kubernetes.yml)"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "\ud83d\udea6 NOC Overview",
      "type": "link",
      "url": "/d/noc-overview",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "\ud83d\udda5\ufe0f Wall \u2014 Servers",
      "type": "link",
      "url": "/d/wall-servers",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "\ud83d\uddc4\ufe0f Wall \u2014 Databases",
      "type": "link",
      "url": "/d/wall-databases",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "\u2638\ufe0f Wall \u2014 Kubernetes Cluster",
      "type": "link",
      "url": "/d/wall-k8s-cluster",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "\u2638\ufe0f Wall \u2014 Kubernetes Workloads",
      "type": "link",
      "url": "/d/wall-k8s-workloads",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "\ud83d\udd0c Wall \u2014 APIs & Network",
      "type": "link",
      "url": "/d/wall-endpoints",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Deployments",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_deployment_created{env=~\"$env\", instance=~\"$cluster\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Deployments degraded",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_deployment_status_replicas_unavailable{env=~\"$env\", instance=~\"$cluster\"} > 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "StatefulSets degraded",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_statefulset_status_replicas_ready{env=~\"$env\", instance=~\"$cluster\"} < kube_statefulset_replicas{env=~\"$env\", instance=~\"$cluster\"}) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "DaemonSets degraded",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_daemonset_status_number_unavailable{env=~\"$env\", instance=~\"$cluster\"} > 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Jobs failed",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_job_status_failed{env=~\"$env\", instance=~\"$cluster\"} > 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "stat",
      "title": "Containers restarting (15m)",
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(increase(kube_pod_container_status_restarts_total{env=~\"$env\", instance=~\"$cluster\"}[15m]) > 0) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 3
      }
    },
    {
      "type": "table",
      "title": "Degraded deployments (empty = all good)",
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2705 All deployments healthy",
          "custom": {
            "align": "left"
          }
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "env": true,
              "uid": true
            },
            "renameByName": {
              "Value": "unavailable"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_unavailable{env=~\"$env\", instance=~\"$cluster\"} > 0",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Pods not running (empty = all good)",
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2705 All pods running",
          "custom": {
            "align": "left"
          }
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "env": true,
              "uid": true
            },
            "renameByName": {
              "Value": "count"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "kube_pod_status_phase{phase=~\"Failed|Pending|Unknown\", env=~\"$env\", instance=~\"$cluster\"} == 1",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "bargauge",
      "title": "Top restarting containers (1h)",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#EAB839",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by(namespace, pod) (increase(kube_pod_container_status_restarts_total{env=~\"$env\", instance=~\"$cluster\"}[1h])) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "bargauge",
      "title": "Running pods per namespace",
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(namespace) (kube_pod_status_phase{phase=\"Running\", env=~\"$env\", instance=~\"$cluster\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{namespace}}"
        }
      ],
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 10
      }
    }
  ]
}
