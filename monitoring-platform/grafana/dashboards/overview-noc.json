      "targets": [
        {
          "refId": "A",
          "expr": "min by(instance) (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}) * 100 or min by(instance) (windows_logical_disk_free_bytes / windows_logical_disk_size_bytes) * 100",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
