# Template — rendered to alertmanager.yml by scripts/deploy.sh (envsubst).
# The rendered alertmanager.yml contains secrets and is git-ignored.
global:
  smtp_smarthost: '${SMTP_SMARTHOST}'
  smtp_from: '${SMTP_FROM}'
  smtp_auth_username: '${SMTP_USER}'
  smtp_auth_password: '${SMTP_PASSWORD}'

route:
  receiver: email
  group_by: ['alertname', 'job', 'env']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Non-production (dev/staging/uat/test): email only, never chat, and re-notify
    # far less often. Listed FIRST so it wins over the critical rule below.
    - matchers:
        - env=~"dev|test|uat|stage|staging"
      receiver: email
      repeat_interval: 24h

    # Production (and anything without an env label): critical goes to email AND chat.
    - matchers:
        - severity="critical"
      receiver: email-and-chat

receivers:
  - name: email
    email_configs:
      - to: '${ALERT_EMAIL_TO}'
        send_resolved: true

  - name: email-and-chat
    email_configs:
      - to: '${ALERT_EMAIL_TO}'
        send_resolved: true
    slack_configs:
      - api_url: '${SLACK_WEBHOOK_URL}'
        channel: '${SLACK_CHANNEL}'
        send_resolved: true
        title: '{{ .CommonLabels.alertname }} ({{ .CommonLabels.severity }})'
        text: "{{ range .Alerts }}{{ .Annotations.summary }}\n{{ end }}"
