# API endpoints to monitor — ONE PER LINE.
#
#   name | url | extras
#
#   name    the label you'll see in Grafana (letters, digits, - _)
#   url     the address to call
#   extras  optional, any order, separated by | :
#             X-API-Key: abc123      any field with a ':' is sent as a request header
#             env=prod               WHICH ENVIRONMENT — dev / staging / prod.
#                                    Add this so the API shows under the Environment
#                                    filter on the dashboards. Without it the API is
#                                    still monitored, but only appears under "All".
#             method=POST            HTTP verb (default GET)
#             body={"ping":true}     request body; sets Content-Type: application/json
#             content-type=text/xml  override the body's content type
#             expect=200,201         status codes that count as healthy (default: 2xx)
#             match=<regexp>         response body must match this, else the probe FAILS
#             insecure=true          skip TLS verification (self-signed certificates)
#             timeout=20s            per-probe timeout (default 10s)
#
# APIs are probed every 60s. A 2xx response = UP, anything else = DOWN.
# A body cannot contain the "|" character — it separates the fields.
#
# Copy this file to  apis.conf  and edit it:
#     cp blackbox/apis.conf.example blackbox/apis.conf
# Then run:  bash scripts/deploy.sh
#
# apis.conf is git-ignored because it contains API keys.

# --- the same API in three environments ------------------------------------
payments-prod    | https://api.example.com/health         | X-API-Key: key1 | env=prod
payments-staging | https://api-staging.example.com/health | X-API-Key: key2 | env=staging
payments-dev     | https://api-dev.example.com/health     | X-API-Key: key3 | env=dev

# --- a bearer token ---------------------------------------------------------
orders-api | https://orders.example.com/v1/ping | Authorization: Bearer replace-with-token | env=prod

# --- POST with a JSON body --------------------------------------------------
search-api | https://api.example.com/v1/search | X-API-Key: replace-me | method=POST | body={"query":"ping","limit":1} | env=prod

# --- POST, accept 200 or 202, and the reply must contain "status":"ok" ------
jobs-api | https://api.example.com/v1/jobs | Authorization: Bearer replace-me | method=POST | body={"type":"noop"} | expect=200,202 | match="status"\s*:\s*"ok" | env=prod

# --- public endpoint, no auth, no environment set ---------------------------
public-api | https://status.example.com/health
