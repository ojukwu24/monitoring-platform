# Template — rendered to sql_exporter.yml by scripts/deploy.sh (envsubst).
# The rendered file contains the DSN (credentials) and is git-ignored.
global:
  scrape_timeout: 10s
  min_interval: 0s

target:
  data_source_name: '${MSSQL_DSN}'
  collectors:
    - mssql_standard

collector_files:
  - "mssql_standard.collector.yml"
