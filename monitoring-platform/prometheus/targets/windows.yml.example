# Windows hosts running windows_exporter (port 9182).
# Empty by default — add only the hosts you actually have, then reload Prometheus.
#
# SHOWING NAMES INSTEAD OF IPs
# Give each host its own block with a `name:` label. That name is what you will
# see in Grafana, in alert emails and in the health check. The IP is still kept
# (as the `address` label) so you never lose it.
#
# - targets: ['10.0.0.21:9182']
#   labels:
#     job: windows
#     os: windows
#     name: WIN-FILE-01       # <- shows as "WIN-FILE-01" instead of 10.0.0.21:9182
#     env: prod               # dev | staging | prod
#
# - targets: ['10.0.0.22:9182']
#   labels:
#     job: windows
#     os: windows
#     name: WIN-APP-01
#     env: prod
#
# Hosts without a `name:` simply keep showing their IP — mixing is fine.
